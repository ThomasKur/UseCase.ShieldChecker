{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ShieldCheckerApi": {
    // Set this to the FQDN of the ShieldChecker HostService API container.
    // After deployment the value is available in the Bicep output 'hostServiceApiAppFqdn'.
    // Example: "ca-shieldchecker-hostserviceapi-prd-001.blueocean.azurecontainerapps.io"
    "Hostname": "",
    // OAuth 2.0 scope for the ShieldChecker-HostServiceApi app registration.
    // Format: "api://{ImportApiClientId}/.default" where ImportApiClientId is the
    // Client ID of the ShieldChecker-HostServiceApi Entra ID app registration.
    "Scope": ""
  },
  "AzureAd": {
    "TenantId": "",
    "ClientId": "",
    "ClientSecret": ""
  },
  "HyperV": {
    // Local administrator username used to authenticate into Hyper-V worker VMs
    // via PowerShell Direct (Invoke-Command -VMName).
    // Leave empty to run scripts locally instead of inside isolated VMs.
    "AdminUsername": "",
    // Local administrator password for the Hyper-V worker VMs.
    "AdminPassword": ""
  }
}
