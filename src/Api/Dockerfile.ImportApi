# ── Build stage ───────────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY ShieldChecker.DataAccess/ShieldChecker.DataAccess.csproj ShieldChecker.DataAccess/
COPY ShieldChecker.ImportApi/ShieldChecker.ImportApi.csproj ShieldChecker.ImportApi/
RUN dotnet restore ShieldChecker.ImportApi/ShieldChecker.ImportApi.csproj

COPY . .
RUN dotnet publish ShieldChecker.ImportApi/ShieldChecker.ImportApi.csproj \
    -c Release -o /app/publish /p:UseAppHost=false

# ── Runtime stage ─────────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app
EXPOSE 8080
ENV ASPNETCORE_URLS=http://+:8080
COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "ShieldChecker.ImportApi.dll"]
