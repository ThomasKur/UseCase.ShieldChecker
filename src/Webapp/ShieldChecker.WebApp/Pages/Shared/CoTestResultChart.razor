@page "/test-results"
@using ShieldChecker.WebApp.Models.Db
@inject IJSRuntime JS
@inject ShieldCheckerContext Context

<div class="card">
    <h2 class="card-header">
        Test Results (Past 30 days)
    </h2>
    <div class="card-body">
        <canvas id="chart-test-results" style="max-height:300px;"></canvas>
    </div>
</div>

@code {
    private List<string> _labels = new();
    private List<int> _counts = new();

    private static readonly string[] ChartColors =
    [
        "rgb(59,125,221)", "rgb(10,10,10)", "rgb(111,66,193)", "rgb(232,62,140)",
        "rgb(220,53,69)", "rgb(253,126,20)", "rgb(252,185,44)", "rgb(28,187,140)",
        "rgb(32,201,151)", "rgb(23,162,184)"
    ];

    protected override void OnInitialized()
    {
        var jobResults = Context.TestJobs
            .Where(j => j.Created > DateTime.UtcNow.AddDays(-30))
            .GroupBy(j => j.Result)
            .Select(g => new { Result = g.Key, Count = g.Count() })
            .ToList();

        foreach (var item in jobResults)
        {
            _labels.Add(item.Result.ToString());
            _counts.Add(item.Count);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var config = new
        {
            type = "doughnut",
            data = new
            {
                labels = _labels,
                datasets = new object[]
                {
                    new
                    {
                        label = "Jobs",
                        data = _counts,
                        backgroundColor = ChartColors.Take(_counts.Count).ToArray(),
                        hoverOffset = 4
                    }
                }
            },
            options = new
            {
                responsive = true,
                maintainAspectRatio = false,
                plugins = new { legend = new { display = true, position = "left" } }
            }
        };

        await JS.InvokeVoidAsync("ShieldCheckerCharts.createChart", "chart-test-results", config);
    }
}

