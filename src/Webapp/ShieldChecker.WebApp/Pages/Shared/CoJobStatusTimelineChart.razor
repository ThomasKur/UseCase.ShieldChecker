@page "/job-status-timeline"
@using ShieldChecker.WebApp.Models.Db
@inject IJSRuntime JS
@inject ShieldCheckerContext Context

<div class="card">
    <h2 class="card-header">
        Job History
    </h2>
    <div class="card-body">
        <canvas id="chart-job-timeline" style="max-height:300px;"></canvas>
    </div>
</div>

@code {
    private List<string> _labels = new();
    private List<int> _successData = new();
    private List<int> _totalData = new();

    protected override void OnInitialized()
    {
        var jobStatusTotal = Context.TestJobs
            .Where(j => j.Created > DateTime.UtcNow.AddDays(-30))
            .GroupBy(j => j.Created.Date)
            .Select(g => new { Date = g.Key, Count = g.Count() })
            .ToList();

        var jobStatusSuccess = Context.TestJobs
            .Where(j => j.Created > DateTime.UtcNow.AddDays(-30)
                        && j.Status == JobStatus.Completed
                        && (j.Result == Models.Db.JobResult.Success
                            || j.Result == Models.Db.JobResult.SuccessWithOtherDetection))
            .GroupBy(j => j.Created.Date)
            .Select(g => new { Date = g.Key, Count = g.Count() })
            .ToList();

        for (var d = DateTime.Now.AddDays(-30).Date; d < DateTime.Now.Date; d = d.AddDays(1))
        {
            _labels.Add(d.ToShortDateString());
            _totalData.Add(jobStatusTotal.FirstOrDefault(j => j.Date == d)?.Count ?? 0);
            _successData.Add(jobStatusSuccess.FirstOrDefault(j => j.Date == d)?.Count ?? 0);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var config = new
        {
            type = "bar",
            data = new
            {
                labels = _labels,
                datasets = new object[]
                {
                    new
                    {
                        type = "bar",
                        label = "Success",
                        data = _successData,
                        backgroundColor = "rgb(59,125,221)"
                    },
                    new
                    {
                        type = "line",
                        label = "Total",
                        data = _totalData,
                        borderColor = "rgb(10,10,10)",
                        fill = false,
                        order = 1
                    }
                }
            },
            options = new
            {
                responsive = true,
                maintainAspectRatio = false,
                plugins = new { legend = new { display = true, position = "left" } },
                scales = new
                {
                    x = new { stacked = true, ticks = new { maxRotation = 0, autoSkip = true } },
                    y = new { stacked = true }
                }
            }
        };

        await JS.InvokeVoidAsync("ShieldCheckerCharts.createChart", "chart-job-timeline", config);
    }
}

