@page "/job-costs"
@using ShieldChecker.WebApp.Models.Db
@inject IJSRuntime JS
@inject ShieldCheckerContext Context

<div class="card">
    <h2 class="card-header">
        Approx Azure Costs
    </h2>
    <div class="card-body">
        <canvas id="chart-job-costs" style="max-height:300px;"></canvas>
        Price in USD with B2ms VMSize and average Runtime of @_workerTimeout minutes.
    </div>
</div>

@code {
    private List<string> _labels = new();
    private List<double> _costData = new();
    private int _workerTimeout;

    protected override void OnInitialized()
    {
        var jobStatusTotal = Context.TestJobs
            .Where(j => j.Created > DateTime.UtcNow.AddDays(-30))
            .GroupBy(j => j.Created.Date)
            .Select(g => new { Date = g.Key.Date, Count = g.Count() })
            .ToList();

        var settings = Context.Settings.FirstOrDefault();
        _workerTimeout = settings?.JobTimeout ?? 60;

        for (var d = DateTime.Now.AddDays(-30).Date; d < DateTime.Now.Date; d = d.AddDays(1))
        {
            _labels.Add(d.ToShortDateString());
            var count = jobStatusTotal.FirstOrDefault(j => j.Date == d)?.Count ?? 0;
            _costData.Add(Math.Round(count * (_workerTimeout / 60.0) * 0.09, 4));
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var config = new
        {
            type = "line",
            data = new
            {
                labels = _labels,
                datasets = new object[]
                {
                    new
                    {
                        label = "Cost (USD)",
                        data = _costData,
                        backgroundColor = "rgba(59,125,221,0.2)",
                        borderColor = "rgb(59,125,221)",
                        fill = true,
                        tension = 0.3
                    }
                }
            },
            options = new
            {
                responsive = true,
                maintainAspectRatio = false,
                plugins = new { legend = new { display = true, position = "left" } },
                scales = new
                {
                    x = new { stacked = true, ticks = new { maxRotation = 0, autoSkip = true } },
                    y = new { stacked = true, title = new { display = true, text = "Costs in USD" } }
                }
            }
        };

        await JS.InvokeVoidAsync("ShieldCheckerCharts.createChart", "chart-job-costs", config);
    }
}

