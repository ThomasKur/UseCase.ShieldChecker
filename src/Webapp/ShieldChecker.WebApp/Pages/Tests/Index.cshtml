@page
@model ShieldChecker.WebApp.Pages.Tests.IndexModel

@{
    ViewData["Title"] = "Tests";
}

<h1>Tests</h1>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    var alertClass = Model.StatusMessage.StartsWith("Error:") ? "alert-danger" : "alert-success";
    <div class="alert @alertClass alert-dismissible fade show" role="alert">
        @Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<p>
    <a asp-page="Create">Create New</a>
</p>
<form asp-page="./Index" method="get">
    <div class="form-actions no-color">
        <p>
            Find by name:
            <input type="text" name="SearchString" value="@Model.CurrentFilter" />
            <input type="submit" value="Search" class="btn btn-primary" /> |
            <a asp-page="./Index">Back to full List</a>
        </p>
    </div>
</form>
<table class="table">
    <thead>
        <tr>
            <th>
                OS
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Test[0].MitreTechnique)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Test[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Test[0].Modified)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Test[0].ModifiedBy)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Test[0].Enabled)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Test) {
            bool itemCanShare = Model.TestCanBeShared.TryGetValue(item.ID, out bool itemCs) && itemCs;
            <tr>
                <td>
                    @if (((int)item.OperatingSystem) == 0){
                        <i class="fa-brands fa-windows"></i>
                    }
                    else
                    {
                        <i class="fa-brands fa-linux"></i>
                    }
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.MitreTechnique)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Modified)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ModifiedBy.DisplayName)
                </td>
                <td>
                    @Html.DisplayTextFor(modelItem => item.Enabled)
                </td>
                <td>
                    @if (item.ReadOnly == null || !item.ReadOnly.Value) {
                        <a asp-page="./Edit" asp-route-id="@item.ID"><i class="fa-regular fa-pen-to-square" data-toggle="tooltip" title="Edit"></i></a>
                        <a asp-page="./History" asp-route-id="@item.ID"><i class="fa-solid fa-clock-rotate-left" data-toggle="tooltip" title="History"></i></a>
                    } else {
                        <a asp-page="./Details" asp-route-id="@item.ID"><i class="fa-regular fa-eye" data-toggle="tooltip" title="View"></i></a>
                    }
                    <a href="@Url.Page("./Index", "Schedule", new { id = item.ID })" class="schedule-test-link" data-test-id="@item.ID"><i id="schedule-icon-@item.ID" class="fa-solid fa-play" data-toggle="tooltip" title="Schedule Test"></i></a>
                    @if (item.ReadOnly == null || !item.ReadOnly.Value)
                    {
                        <a asp-page="./Delete" asp-route-id="@item.ID"><i class="fa-regular fa-trash-can" data-toggle="tooltip" title="Delete"></i></a>

                        @if (itemCanShare)
                        {
                            <form method="post" asp-page-handler="Share" asp-route-id="@item.ID" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-link p-0" title="Share to Community">
                                    <i class="fa-solid fa-share-nodes"></i>
                                </button>
                            </form>
                        }
                        else
                        {
                            <span class="text-muted" data-bs-toggle="tooltip" data-bs-placement="top"
                                  title="Only tests with a successful last job run can be shared to the community.">
                                <i class="fa-solid fa-share-nodes"></i>
                            </span>
                        }
                    }

            </td>
        </tr>
}
    </tbody>
</table>
@{
    var prevDisabled = !Model.Test.HasPreviousPage ? "disabled" : "";
    var nextDisabled = !Model.Test.HasNextPage ? "disabled" : "";
}

<a asp-page="./Index"
   asp-route-pageIndex="@(Model.Test.PageIndex - 1)"
   asp-route-currentFilter="@Model.CurrentFilter"
   class="btn btn-primary @prevDisabled">
    Previous
</a>
<a asp-page="./Index"
   asp-route-pageIndex="@(Model.Test.PageIndex + 1)"
   asp-route-currentFilter="@Model.CurrentFilter"
   class="btn btn-primary @nextDisabled">
    Next
</a>

@section Scripts {
    <script>
        document.querySelectorAll('.schedule-test-link').forEach(function (link) {
            link.addEventListener('click', function (e) {
                e.preventDefault();
                var testId = this.dataset.testId;
                var icon = document.getElementById('schedule-icon-' + testId);
                icon.className = 'fa-solid fa-clock';
                fetch(this.href, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                .then(function (response) { return response.json(); })
                .then(function (data) {
                    if (!data.success) {
                        icon.className = 'fa-solid fa-triangle-exclamation';
                        setTimeout(function () {
                            icon.className = 'fa-solid fa-play';
                        }, 3000);
                    }
                })
                .catch(function () {
                    icon.className = 'fa-solid fa-triangle-exclamation';
                    setTimeout(function () {
                        icon.className = 'fa-solid fa-play';
                    }, 3000);
                });
            });
        });
        // Initialize Bootstrap tooltips
        document.addEventListener('DOMContentLoaded', function () {
            var tooltipEls = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipEls.forEach(function (el) { new bootstrap.Tooltip(el); });
        });
    </script>
}